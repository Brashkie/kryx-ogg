# ─── Rust ───────────────────────────────────────────────────────────
/target
**/*.rs.bk
# Cargo.lock: committed for the napi binary crates (reproducible builds),
# which is the recommended practice when a workspace produces binaries.

# ─── Node / TypeScript ──────────────────────────────────────────────
/node_modules
/dist
*.tsbuildinfo

# ─── napi build artifacts (generated by `napi build`) ───────────────
*.node
/index.js
/index.d.ts
/npm/

# ─── Test coverage ──────────────────────────────────────────────────
/coverage

# ─── Editor / OS ────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
